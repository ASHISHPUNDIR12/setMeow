# Use Neon's direct connection URL (pooling off) for the LISTEN connection.
DATABASE_URL=postgresql://user:password@localhost:5432/setmeow
JWT_SECRET=replace-with-the-same-long-random-secret-used-by-the-backend
FRONTEND_ORIGIN=http://localhost:3000
WS_PORT=3002
NODE_ENV=development
# On Render, set NODE_ENV=production and BUN_VERSION=1.4.2.
# Start with: cd apps/websockets && WS_PORT=$PORT bun run start
