# HTTP listener. Hosting platforms usually provide PORT automatically.
PORT=3001

# PostgreSQL connection string for the deployed database.
DATABASE_URL=postgresql://user:password@localhost:5432/setmeow

# Long random secret used to sign and verify session and OAuth state tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Exact public frontend origin, with scheme and no trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Optional OAuth providers. Leave unset to disable that provider.
# Configure each provider callback as:
#   https://your-frontend.example.com/api/auth/oauth/google/callback
#   https://your-frontend.example.com/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
