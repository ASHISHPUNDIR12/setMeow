# Backend REST API origin. Next.js proxies browser requests from /api/* to this URL.
# In production, use the publicly reachable HTTPS origin of the backend.
API_URL=http://localhost:3001

# WebSocket service URL used by the browser. Use wss:// in production.
# Socket tickets allow a separate hostname from the frontend.
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# Legacy fallback for API_URL. Prefer API_URL for new deployments.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Vercel Production environment values:
# API_URL=https://setmeow-backend.onrender.com
# NEXT_PUBLIC_WS_URL=wss://setmeow-sockets.onrender.com
